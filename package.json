{
  "name": "pg-core-pw",
  "version": "2.0.0",
  "description": "Page Object Model framework for Playwright test automation",
  "main": "./built/index.js",
  "types": "./built/index.d.ts",
  "files": [
    "built/",
    "lib/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test:local": "playwright test --headed",
    "lint": "eslint --ext .ts ./ --cache",
    "lint:fix": "eslint --ext .ts ./ --cache --fix",
    "tsc": "tsc --noEmit",
    "build": "rm -rf built && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-gladoon/pg-core-pw.git"
  },
  "keywords": [
    "playwright-core"
  ],
  "author": "Paul Gladoon",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/paul-gladoon/pg-core-pw/issues"
  },
  "homepage": "https://github.com/paul-gladoon/pg-core-pw#readme",
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/lodash": "4.17.16",
    "@types/node": "24.3.0",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.10.0",
    "eslint": "8.53.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.1.7",
    "lint-staged": "16.3.1",
    "prettier": "3.2.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "lodash": "4.17.21"
  }
}
