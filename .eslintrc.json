{
  "env": {
      "browser": true,
      "es2021": true
  },
  "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
  },
  "plugins": [
      "@typescript-eslint",
      "prettier"
  ],
  "rules": {
      "prettier/prettier": "error",
      "no-console": "error",
      "no-trailing-spaces": "error",
      "semi": ["error", "never"],
      "quotes": ["error", "single", {"allowTemplateLiterals": true }]
  }
}
